{
  "name": "nimeshvaghasiya.github.io",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "python -m http.server 4321",
    "dev": "python -m http.server 4321",
    "build": "node -e \"const fs=require('fs'); ['dist','dist/css','dist/js'].forEach(d=>!fs.existsSync(d)&&fs.mkdirSync(d,{recursive:true})); fs.copyFileSync('index.html','dist/index.html'); fs.copyFileSync('css/style.css','dist/css/style.css'); fs.copyFileSync('js/app.js','dist/js/app.js'); fs.cpSync('assets','dist/assets',{recursive:true}); if(fs.existsSync('sitemap.xml')) fs.copyFileSync('sitemap.xml','dist/sitemap.xml'); if(fs.existsSync('robots.txt')) fs.copyFileSync('robots.txt','dist/robots.txt');\" && tar -zcvf archive.tar.gz dist/*",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.1.6",
    "@angular/common": "^16.1.6",
    "@angular/compiler": "^16.1.6",
    "@angular/core": "^16.1.6",
    "@angular/forms": "^16.1.6",
    "@angular/platform-browser": "^16.1.6",
    "@angular/platform-browser-dynamic": "^16.1.6",
    "@angular/router": "^16.1.6",
    "@angular/service-worker": "^16.1.6",
    "@babel/generator": "^7.22.9",
    "@babel/parser": "^7.22.7",
    "@babel/traverse": "^7.22.8",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.0",
    "zone.js": "~0.13.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.1.5",
    "@angular/cli": "~16.1.5",
    "@angular/compiler-cli": "^16.1.6",
    "@types/jasmine": "~4.3.5",
    "@types/node": "^20.4.4",
    "angular-cli-ghpages": "0.6.2",
    "autoprefixer": "^10.4.14",
    "gh-pages": "^5.0.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "~5.1.6"
  }
}
